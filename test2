<style>:root{--bg:#11100e;--panel:#1b1915;--panel2:#242018;--line:#3c3428;--gold:#d6ad60;--gold2:#f1d18f;--text:#f4efe6;--muted:#b9ad9b;--green:#80b192;--red:#c8796b}*{box-sizing:border-box}body{margin:0;font-family:Arial,"Noto Sans KR",sans-serif;background:linear-gradient(160deg,#0e0d0b,#19150f 65%,#0c0b09);color:var(--text);min-height:100vh}button,input,select{font:inherit}.wrap{max-width:1240px;margin:auto;padding:24px}header{display:flex;justify-content:space-between;align-items:center;padding:10px 0 24px;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:13px}.logo{width:46px;height:46px;border:1px solid var(--gold);border-radius:50%;display:grid;place-items:center;font-size:24px;background:#201b14}h1{font-family:Georgia,serif;font-weight:500;letter-spacing:.8px;margin:0;font-size:28px}.sub{font-size:13px;color:var(--muted);margin-top:4px}.stats{display:flex;gap:10px}.stat{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:9px 13px;text-align:center;min-width:78px}.stat b{display:block;color:var(--gold2);font-size:18px}.stat span{font-size:11px;color:var(--muted)}.search{margin:25px 0 18px;padding:20px;background:rgba(27,25,21,.92);border:1px solid var(--line);border-radius:18px;box-shadow:0 16px 40px #0005}.search-grid{display:grid;grid-template-columns:1fr 1fr 1fr 2fr auto;gap:12px}label{font-size:12px;color:var(--muted);display:block;margin:0 0 7px 2px}select,input{width:100%;padding:12px 13px;border-radius:10px;border:1px solid #4b4133;background:#14120f;color:var(--text);outline:none}select:focus,input:focus{border-color:var(--gold)}.search-btn{align-self:end;height:43px;border:0;border-radius:10px;padding:0 22px;background:linear-gradient(135deg,var(--gold),#a97928);color:#18130c;font-weight:bold;cursor:pointer}.toolbar{display:flex;justify-content:space-between;align-items:center;margin:18px 2px}.toolbar h2{font-size:18px;margin:0;font-weight:600}.toolbar small{color:var(--muted)}.filters{display:flex;gap:8px;flex-wrap:wrap}.chip{border:1px solid var(--line);background:var(--panel);color:var(--muted);padding:7px 11px;border-radius:999px;cursor:pointer}.chip.active{border-color:var(--gold);color:var(--gold2);background:#2a2114}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:linear-gradient(165deg,#211e19,#171512);border:1px solid var(--line);border-radius:17px;overflow:hidden;cursor:pointer;transition:.2s;position:relative}.card:hover{transform:translateY(-4px);border-color:#7d6339;box-shadow:0 16px 35px #0008}.visual{height:210px;display:grid;place-items:center;position:relative;background:radial-gradient(circle at 50% 30%,#4b3920,#17130e 65%)}.bottle{width:72px;height:145px;border:2px solid #c7a66b80;border-radius:12px 12px 17px 17px;background:linear-gradient(90deg,#553316,#a26725 48%,#4b2b12);box-shadow:0 15px 25px #0009;position:relative}.bottle:before{content:"";position:absolute;width:30px;height:35px;left:19px;top:-31px;border:2px solid #c7a66b80;border-bottom:0;border-radius:5px 5px 0 0;background:#3c2b1b}.label{position:absolute;left:7px;right:7px;top:45px;background:#e9dfc8;color:#251b10;padding:12px 3px;text-align:center;font-family:Georgia,serif;font-size:12px;border:1px solid #b99c64}.badge{position:absolute;top:13px;right:13px;background:#10100ddd;border:1px solid #ffffff22;border-radius:999px;padding:6px 9px;font-size:11px;color:var(--gold2)}.card-body{padding:16px}.card h3{font-family:Georgia,serif;font-size:20px;margin:0 0 6px}.meta{font-size:13px;color:var(--muted);margin-bottom:13px}.tags{display:flex;gap:6px;flex-wrap:wrap}.tag{font-size:11px;background:#2d281f;border:1px solid #453b2d;padding:5px 7px;border-radius:7px;color:#cfbfaa}.tasted{position:absolute;top:13px;left:13px;border-radius:50%;width:34px;height:34px;display:grid;place-items:center;background:#15120eee;border:1px solid #ffffff25;font-size:15px}.tasted.yes{background:#234433;color:#bff1ce;border-color:#47765a}.empty{text-align:center;paddin