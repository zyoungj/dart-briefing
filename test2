;padding-top:15px;border-top:1px dashed var(--line)}@media(max-width:900px){.search-grid{grid-template-columns:1fr 1fr}.search-btn{grid-column:span 2}.grid{grid-template-columns:repeat(2,1fr)}.detail-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.wrap{padding:14px}.stats{display:none}.search-grid{grid-template-columns:1fr}.search-btn{grid-column:auto}.grid{grid-template-columns:1fr}.variants{grid-template-columns:1fr}.toolbar{align-items:flex-start;gap:10px;flex-direction:column}}</style>
