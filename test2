<body>
<div class="wrap">
  <header>
    <div class="brand">
      <div class="logo">🥃</div>
      <div><h1>Whisky Archive</h1><div class="sub">정적 위스키 도감 · 문화 · 역사 · 나의 시음 기록</div></div>
    </div>
    <div class="stats">
      <div class="stat"><b id="allCount">0</b><span>전체 위스키</span></div>
      <div class="stat"><b id="tastedCount">0</b><span>마셔본 위스키</span></div>
    </div>
  </header>

  <section class="search">
    <div class="search-grid">
      <div><label>위스키 종류</label><select id="type"><option value="">전체</option></select></div>
      <div><label>국가</label><select id="country"><option value="">전체</option></select></div>
      <div><label>지역</label><select id="region"><option value="">전체</option></select></div>
      <div><label>위스키명</label><input id="keyword" placeholder="예: Macallan, Yamazaki, 발베니" /></div>
      <button class="search-btn" onclick="render()">검색</button>
    </div>
  </section>

  <div class="toolbar">
    <div><h2>검색 결과</h2><small id="resultText"></small></div>
    <div class="filters">
      <button class="chip active" data-view="all">전체</button>
      <button class="chip" data-view="tasted">마셔봄</button>
      <button class="chip" data-view="untasted">아직 안 마셔봄</button>
    </div>
  </div>

  <main class="grid" id="list"></main>
</div>

<dialog id="detailDialog">
  <div id="detail"></div>
</dialog>

